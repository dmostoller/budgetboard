# Convex — create a deployment with `npx convex dev`, which fills these in
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # generate one: npx -y @better-auth/cli secret

# Postgres for Better Auth's users/sessions/accounts/jwks tables.
# Optional locally (falls back to an in-memory store), required in production.
# After setting it, run: npx -y @better-auth/cli migrate
#
# The `jwks` table holds the RS256 keypair Better Auth signs Convex tokens
# with, so this migration is required before sign-in works — without it
# /api/auth/token returns a 500.
DATABASE_URL=

# Google OAuth (optional — email/password sign-in works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini powers the AI assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Convex deployment environment variables (not read from this file) ---
#
# Convex verifies the JWTs this app mints, so it needs to know which issuer to
# trust. Set this on the deployment itself, matching BETTER_AUTH_URL exactly:
#
#   npx convex env set SITE_URL http://localhost:3000
#
# It also needs the public signing keys — and it fetches those over the public
# internet, which cannot reach localhost. So locally, hand them over directly
# (with the app running):
#
#   npx convex env set JWKS "$(./scripts/jwks-data-uri.sh)"
#
# Leave JWKS unset in production, where the deployed origin is reachable and
# ordinary OIDC discovery works. See convex/auth.config.ts.
#
# Optional — lets the weekly briefing phrase its findings with the model
# instead of the built-in templates:
#
#   npx convex env set GEMINI_API_KEY <key>
